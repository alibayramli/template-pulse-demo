{
  "name": "@abayramli/backstage-plugin-template-pulse-backend",
  "version": "0.1.0",
  "description": "Template Pulse backend: permission-aware execution analytics and searchable template run history.",
  "license": "Apache-2.0",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "template-pulse",
    "features": {
      ".": "@backstage/BackendFeature"
    },
    "pluginPackages": [
      "@abayramli/backstage-plugin-template-pulse",
      "@abayramli/backstage-plugin-template-pulse-backend",
      "@abayramli/backstage-plugin-template-pulse-common",
      "@abayramli/backstage-plugin-template-pulse-node"
    ],
    "peerModules": [
      "@abayramli/backstage-plugin-scaffolder-backend-module-template-pulse"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "build": "backstage-cli package build",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@abayramli/backstage-plugin-template-pulse-common": "workspace:^",
    "@abayramli/backstage-plugin-template-pulse-node": "workspace:^",
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-permission-common": "^0.9.11",
    "@backstage/plugin-scaffolder-node": "^0.13.7",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.1"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "jest": "~30.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibayramli/template-pulse.git",
    "directory": "plugins/template-pulse-backend"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "homepage": "https://github.com/alibayramli/template-pulse#readme",
  "bugs": "https://github.com/alibayramli/template-pulse/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "scaffolder",
    "template-pulse",
    "analytics"
  ],
  "engines": {
    "node": "22 || 24"
  }
}
