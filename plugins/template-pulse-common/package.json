{
  "name": "@template-pulse/plugin-common",
  "version": "0.1.0",
  "description": "Shared analytics contracts and permissions for Template Pulse.",
  "license": "Apache-2.0",
  "backstage": {
    "role": "common-library",
    "pluginId": "template-pulse",
    "pluginPackages": [
      "@template-pulse/plugin",
      "@template-pulse/plugin-backend",
      "@template-pulse/plugin-common",
      "@template-pulse/plugin-node"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "backstage-cli package lint",
    "build": "backstage-cli package build",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/plugin-permission-common": "^0.9.11"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "jest": "~30.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibayramli/template-pulse.git",
    "directory": "plugins/template-pulse-common"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  }
}
