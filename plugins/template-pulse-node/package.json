{
  "name": "@abayramli/backstage-plugin-template-pulse-node",
  "version": "0.1.0",
  "description": "Backend analytics utilities and an authenticated client for Template Pulse Scaffolder history.",
  "license": "Apache-2.0",
  "backstage": {
    "role": "node-library",
    "pluginId": "template-pulse",
    "pluginPackages": [
      "@abayramli/backstage-plugin-template-pulse",
      "@abayramli/backstage-plugin-template-pulse-backend",
      "@abayramli/backstage-plugin-template-pulse-common",
      "@abayramli/backstage-plugin-template-pulse-node"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
