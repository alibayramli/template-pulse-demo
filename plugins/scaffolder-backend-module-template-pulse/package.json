{
  "name": "@abayramli/backstage-plugin-scaffolder-backend-module-template-pulse",
  "version": "0.1.0",
  "description": "Scaffolder backend module for permission-aware Template Pulse database history.",
  "license": "Apache-2.0",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend",
    "features": {
      ".": "@backstage/BackendFeature"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@abayramli/backstage-plugin-template-pulse-common": "workspace:^",
    "@abayramli/backstage-plugin-template-pulse-node": "workspace:^",
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-permission-common": "^0.9.11",
    "@backstage/plugin-scaffolder-common": "^2.3.0",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.1",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "better-sqlite3": "^12.0.0",
    "jest": "~30.2.0",
    "pg": "^8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibayramli/template-pulse.git",
    "directory": "plugins/scaffolder-backend-module-template-pulse"
  },
  "homepage": "https://github.com/alibayramli/template-pulse#readme",
  "bugs": "https://github.com/alibayramli/template-pulse/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "scaffolder",
    "template-pulse",
    "analytics"
  ],
  "engines": {
    "node": "22 || 24"
  }
}
