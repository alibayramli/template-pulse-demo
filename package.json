{
  "name": "template-pulse-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "start:demo": "yarn workspace app start --config ../../app-config.static.yaml",
    "build:demo": "node scripts/build-static-demo.mjs",
    "test:demo": "yarn workspace app test --watch=false --maxWorkers=2",
    "build": "backstage-cli repo build --all",
    "tsc": "tsc",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test --watch=false --maxWorkers=2",
    "lint": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "start:user": "yarn start --config app-config.yaml --config app-config.user.yaml",
    "sync:plugins": "node scripts/sync-plugins.mjs",
    "seed:analytics": "node scripts/seed-analytics.mjs"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@types/jest": "^30.0.0",
    "better-sqlite3": "^12.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0",
    "yaml": "^2.9.1"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "got": "11.8.6"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0",
  "description": "A local Backstage demo for Template Pulse template health and adoption analytics."
}
